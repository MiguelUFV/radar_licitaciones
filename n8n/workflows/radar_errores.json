{
  "name": "radar_errores",
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Madrid"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "fallo",
      "name": "Cuando falla un workflow del radar",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO incidencias (workflow, n8n_execution_id, nodo, mensaje) VALUES ($1, $2, $3, 'El radar no ha podido terminar su tarea automática: se paró en el paso «' || coalesce($3, 'desconocido') || '». Lo ya guardado no se pierde y se reintenta en la próxima ejecución. Detalle técnico: ' || coalesce($4, '(sin detalle)'))",
        "options": {
          "queryReplacement": "={{ $json.workflow?.name }},{{ $json.execution?.id }},{{ $json.execution?.lastNodeExecuted }},{{ $json.execution?.error?.message }}"
        }
      },
      "id": "anotar",
      "name": "Anotar la incidencia",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "TB1j0B1xkZ3BYYvF",
          "name": "radar_postgres"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "correo@oculto.invalid",
        "toEmail": "correo@oculto.invalid",
        "subject": "=Radar de licitaciones: algo ha fallado esta noche",
        "emailFormat": "both",
        "html": "={{ $json.mensaje }}",
        "text": "={{ $json.mensaje }}",
        "options": {}
      },
      "id": "avisar",
      "name": "Avisar por correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        480,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "U6ldV9fue02O9Iso",
          "name": "SMTP del radar"
        }
      }
    }
  ],
  "connections": {
    "Cuando falla un workflow del radar": {
      "main": [
        [
          {
            "node": "Anotar la incidencia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anotar la incidencia": {
      "main": [
        [
          {
            "node": "Avisar por correo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}