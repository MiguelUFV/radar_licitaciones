# Copia este fichero como .env y rellénalo (docs/ENTORNO.md §4).
# .env nunca se sube a git.

# --- Anthropic (obligatoria, de pago) ---
ANTHROPIC_API_KEY=
# Modelos (docs/DECISIONES.md D06). El de triaje se decide en el experimento de la Fase 4;
# el candidato alternativo es claude-haiku-4-5.
MODELO_TRIAJE=claude-opus-5
MODELO_EXTRACCION=claude-opus-5

# --- Control de coste (euros) ---
PRESUPUESTO_DIARIO_EUR=2.00
PRESUPUESTO_EVALUACION_EUR=60.00

# --- Postgres ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar
POSTGRES_DB_N8N=n8n

# --- n8n ---
# Genérala una vez y guárdala también en un gestor de contraseñas.
N8N_ENCRYPTION_KEY=
# Se crea en n8n: Settings → n8n API.
N8N_API_KEY=
GENERIC_TIMEZONE=Europe/Madrid

# --- Informe diario ---
# La contraseña de aplicación de Gmail se guarda en las credenciales de n8n, no aquí.
# Aquí solo van las direcciones y a nombre de qué empresa se manda el correo del día.
CORREO_REMITENTE=radar.licitaciones@gmail.com
CORREO_DESTINO=tu-direccion@ejemplo.com
CORREO_EMPRESA=Empresa A
INFORME_DESTINATARIO=

# --- Privacidad ---
# Sal para el hash de los NIF de personas físicas (docs/DATOS.md §7).
SAL_HASH_PERSONAS=

# --- Fuentes (públicas, sin clave) ---
PLACSP_FEED_URL=https://contrataciondelsectorpublico.gob.es/sindicacion/sindicacion_643/licitacionesPerfilesContratanteCompleto3.atom
TIPO_CAMBIO_URL=https://api.frankfurter.app/latest?from=USD&to=EUR

# Sal para seudonimizar el DNI de los adjudicatarios autonomos (docs/DATOS.md 7).
# Generala una vez: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si cambia, los seudonimos cambian y se pierde el enlace con lo ya guardado.
SAL_PERSONAS=

# Cambio dolar-euro para pasar el coste a euros. Fuente: api.frankfurter.app (publica los
# tipos del BCE), tipo del 18-09-2026. Cuando la descarga automatica este hecha, este valor
# solo se usa si falla (decision D33).
TIPO_CAMBIO_USD_EUR=0.8726
TIPO_CAMBIO_ORIGEN=BCE via api.frankfurter.app, 2026-09-18
